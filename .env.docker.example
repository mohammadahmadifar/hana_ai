# ==============================================================
# تنظیمات نصب داکری «هانا»
#
# این فایل را دستی کپی نکنید؛ install.sh خودش از رویش .env می‌سازد و
# رمزها و کلید برنامه را تصادفی پر می‌کند:
#
#     bash install.sh
#
# بعد از هر تغییر در .env، برای اثر کردنش:  docker compose up -d
# ==============================================================

# پورتی که پنل روی مرورگر باز می‌شود: http://localhost:8101
HANA_PORT=8101

APP_ENV=production
APP_DEBUG=false
APP_NAME="سامانه پیش‌اعتبارسنجی مجوز"
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=info

# کلید رمزنگاری لاراول — install.sh می‌سازدش. دستی عوضش نکنید:
# با عوض شدن کلید، نشست‌های باز و مقدارهای رمزنگاری‌شده بی‌اعتبار می‌شوند.
APP_KEY=

# پایگاه داده (میزبانش داخل شبکهٔ داکر «db» است و در docker-compose.yml ثابت شده)
DB_DATABASE=hana
DB_USERNAME=hana
DB_PASSWORD=
DB_ROOT_PASSWORD=

# رمز چهار حساب نمونه‌ای که بار اول ساخته می‌شوند — با همین وارد پنل می‌شوید.
# نام کاربری، کد ملی است نه ایمیل.
SEED_PASSWORD=

# موتور پایتون
HANA_ENGINE_TIMEOUT=300

# «ارزیابی دقت» چند هسته بردارد. روی لپ‌تاپ چهارهسته‌ای ۴ بگذارید؛
# بزرگ‌تر از تعداد هسته‌ها کار را کندتر می‌کند نه سریع‌تر.
HANA_EVALUATE_WORKERS=8
HANA_EVALUATE_CHUNK=40

# فایل موقت موتور بعد از چند روز پاک شود
HANA_PRUNE_DAYS=7
