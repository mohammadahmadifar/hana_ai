# تصاویر چاپ‌شده روی قالب  (image_writer.py)
dataset/generated/

# تصاویر با اعوجاج عمدی  (image_processing.py)
dataset/processed/

# تصاویر پیش‌پردازش‌شده  (image_preprocessing.py)
dataset/preprocessed/

# متن استخراج‌شده  (ocr_engine.py)
dataset/ocr_results/

# لیبل‌های JSON  (label_generator.py)
dataset/labels/

# خروجی موقت ابزارهای اندازه‌گیری  (scripts/benchmark.py ، hana:evaluate-extraction)
dataset/benchmark/

# تصاویر دیباگ سگمنت پلاک  (vehicle_card_ocr.py)
debug_segments.png
**/debug_segments.png


