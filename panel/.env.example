# ==============================================================
# نمونهٔ تنظیمات پنل «هانا»
#
# این فایل را کپی کنید روی .env و مقدارهای نشان‌دار را پر کنید:
#     cp .env.example .env
#     php artisan key:generate      ← APP_KEY را خودش پر می‌کند
#
# فایل .env هرگز داخل گیت نمی‌رود؛ رمزهای واقعی فقط آن‌جا می‌مانند.
# ==============================================================

APP_NAME="سامانه پیش‌اعتبارسنجی مجوز"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran

# آدرسی که پنل با آن باز می‌شود. اگر پورت را عوض کردید این را هم عوض کنید.
APP_URL=http://127.0.0.1:8101

# رابط کاربری فارسی و راست‌چین است؛ این دو را عوض نکنید.
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------
# پایگاه داده — MariaDB یا MySQL
# همان نام کاربری/پایگاه‌داده‌ای که در مرحلهٔ نصب ساختید
# --------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hana
DB_USERNAME=hana
DB_PASSWORD=

# --------------------------------------------------------------
# صف، نشست و کش — همه روی Redis
#
# ⚠️ QUEUE_CONNECTION حتماً redis بماند: کارهای سنگین (OCR، تولید انبوه،
# ارزیابی دقت) داخل صف اجرا می‌شوند و اسکریپت کارگر صف هم redis می‌خواند.
# --------------------------------------------------------------
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
CACHE_STORE=redis

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --------------------------------------------------------------
# موتور پایتون (OCR و ساخت تصویر مصنوعی)
#
# HANA_ENGINE_ROOT = پوشه‌ای که hana_engine داخل آن است، یعنی ریشهٔ مخزن.
# HANA_ENGINE_PYTHON = مفسر پایتونِ همان محیط مجازی که requirements.txt در آن نصب شده.
# هر دو را با مسیر واقعی روی ماشین خودتان جایگزین کنید.
# --------------------------------------------------------------
HANA_ENGINE_ROOT=/path/to/hana_ai
HANA_ENGINE_PYTHON=/path/to/hana_ai/.venv/bin/python
HANA_ENGINE_TIMEOUT=300

# --------------------------------------------------------------
# رمز حساب‌های نمونه‌ای که php artisan db:seed می‌سازد — با همین وارد پنل
# می‌شوید. اگر این خط را خالی بگذارید یا پاکش کنید، رمز پیش‌فرض توسعه یعنی
# hana@1405 گذاشته می‌شود. روی هر نصبِ غیرِ آزمایشی حتماً عوضش کنید.
# بدون فاصله بنویسید، وگرنه داخل گیومه بگذاریدش.
# --------------------------------------------------------------
SEED_PASSWORD=CHANGE_ME_TOO

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
